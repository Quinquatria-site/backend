# 로컬 개발용 환경변수 템플릿.
#
# 이 파일을 `.env`로 복사해 값을 채운다. `.env`는 Git에 올라가지 않는다.
# 배포 환경은 이 파일을 쓰지 않고 플랫폼이 환경변수를 직접 주입한다.
# 실제 환경변수가 파일보다 우선하므로 배포 동작은 이 파일의 존재와 무관하다.
#
#   cp .env.example .env
#   uv run --env-file .env --package backoffice \
#       fastapi dev apps/backoffice/src/backoffice/main.py
#
# 매번 플래그를 치기 싫으면 셸에 한 번 걸어둔다.
#
#   export UV_ENV_FILE=.env

# --- 필수 ---

# Backoffice와 Customer가 공유하는 DB. 앱 prefix를 붙이지 않는 유일한 설정이며
# `alembic upgrade`도 같은 변수를 읽는다.
#
# 드라이버는 psycopg만 받는다. 이 저장소는 앱과 alembic이 async 엔진을,
# 테스트 픽스처가 sync 엔진을 함께 쓰는데 psycopg 하나가 양쪽을 다 지원한다.
# asyncpg는 async 전용이고 의존성에도 없어서 거부된다.
# `postgresql://` 로 써도 psycopg로 정규화된다.
DATABASE_URL=postgresql+psycopg://quinquatria:devpw@localhost:5432/quinquatria

# 토큰 발급 코드. 로컬 값과 배포 값은 반드시 다르게 둔다.
BACKOFFICE_ISSUANCE_CODE=local-dev-issuance-code

# JWT 서명 키. 32 byte 이상이어야 기동한다.
BACKOFFICE_JWT_SIGNING_KEY=local-dev-signing-key-change-me-32b

BACKOFFICE_S3_BUCKET=quinquatria-local
BACKOFFICE_S3_REGION=ap-northeast-2

# --- 선택 (주석을 풀면 기본값을 덮어쓴다) ---

# 로컬에서 실제 S3에 붙어볼 때만 쓰는 AWS credential.
#
# 앱 설정에는 access key 필드가 없다. 정적 키는 만료가 없어 유출되면 회수할
# 방법이 없으므로, 배포는 workload IAM role의 임시 credential만 쓴다. 아래는
# botocore 기본 탐색 체인이 읽는 표준 변수라 `BACKOFFICE_` prefix가 붙지 않고,
# 배포 환경에는 절대 넣지 않는다.
#
# 리전은 BACKOFFICE_S3_REGION이 세션에 직접 들어가므로 AWS_REGION은 필요 없다.
# 키를 파일에 두기 싫으면 `aws configure --profile quinquatria-local` 후
# AWS_PROFILE만 지정해도 같다.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# assume-role로 받은 임시 credential일 때만 함께 지정한다.
# AWS_SESSION_TOKEN=
# AWS_PROFILE=quinquatria-local

# MinIO나 LocalStack 같은 로컬 S3 호환 스토리지를 쓸 때만 지정한다.
# 배포에서는 비워 둬야 실제 AWS 엔드포인트를 쓴다.
# BACKOFFICE_S3_ENDPOINT_URL=http://localhost:9000

# BACKOFFICE_TOKEN_TTL_SECONDS=18000
# BACKOFFICE_PRESIGNED_URL_TTL_SECONDS=300
# BACKOFFICE_MAX_IMAGE_BYTES=10485760
# BACKOFFICE_CLEANUP_GRACE_SECONDS=86400
# BACKOFFICE_CLEANUP_BATCH_SIZE=500
